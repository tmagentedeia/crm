PORT=3000
DATABASE_URL=postgres://usuario:senha@host:5432/crm_salao
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
# Chave usada pelo N8N (header x-api-key) para acessar a API
N8N_API_KEY=troque-por-outra-string-longa
# Permite criar novos salões via POST /api/auth/register (deixe false em produção depois de criar o seu)
ALLOW_SIGNUP=true
# E-mails (separados por vírgula) com acesso à tela de Administração
ADMIN_EMAILS=seu@email.com
