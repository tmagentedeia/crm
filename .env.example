PORT=3000
DATABASE_URL=postgres://usuario:senha@host:5432/crm
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
# Chave global do N8N (header x-api-key). Cada empresa tem a sua própria chave (gerada na tela Administração);
# esta é usada como segredo dos avisos que o painel envia aos webhooks e, durante a transição, vale em qualquer empresa.
N8N_API_KEY=troque-por-outra-string-longa
# Quando todas as integrações já usarem a chave da empresa, mude para false: a chave global deixa de valer nas rotas /n8n
ALLOW_GLOBAL_KEY=true
# Permite criar novas empresas via POST /api/auth/register (deixe false em produção depois de criar o seu)
ALLOW_SIGNUP=true
# E-mails (separados por vírgula) com acesso à tela de Administração
ADMIN_EMAILS=seu@email.com

# Opcional: webhook do N8N que espelha os agendamentos no Google Agenda
N8N_WEBHOOK_URL=

# Opcional: webhook do N8N que avisa o cliente da fila de espera quando um horário abre
N8N_WAITLIST_WEBHOOK_URL=
